{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.trimTrailingWhitespace": true,
		"files.insertFinalNewline": true,
		"files.trimFinalNewlines": true,
		"files.associations": {
			"*.ghostty": "properties",
			"**/ssh/config": "properties",
			"**/vscode/settings.json": "jsonc"
		},
		"json.schemas": [
			{
				"fileMatch": [
					"**/vscode/settings.json"
				],
				"url": "vscode://schemas/settings/user"
			}
		],
		"workbench.editor.customLabels.patterns": {
			"**/ssh/config": "ssh > ${filename}",
			"**/ghostty/config.ghostty": "ghostty > ${filename}",
			"**/fish/config.fish": "fish > ${filename}.${extname}",
			"**/fish/functions/*.fish": "fish fn > ${filename}"
		}
	}
}
